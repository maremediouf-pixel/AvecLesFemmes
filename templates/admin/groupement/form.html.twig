{% extends 'base.html.twig' %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
    <h1>{{ titre }}</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.adresse) }}
        {{ form_row(form.telephone) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(form) }}

    <p><a href="{{ path('admin_groupement_index') }}">Annuler</a></p>
{% endblock %}